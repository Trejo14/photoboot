{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Birdcam",
  "version": "0.1.0",
  "identifier": "com.birdcam.photobooth.booth",
  "build": {
    "beforeDevCommand": "pnpm --filter @photobooth/booth dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @photobooth/booth build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Birdcam",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "fullscreen": false,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}