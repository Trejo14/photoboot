{
  "name": "photobooth",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,prisma}\"",
    "db:migrate": "pnpm --filter @photobooth/api db:migrate",
    "db:studio": "pnpm --filter @photobooth/api db:studio",
    "db:seed": "pnpm --filter @photobooth/api db:seed"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  }
}
