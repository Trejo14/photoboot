generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  plan      String   @default("basic")
  createdAt DateTime @default(now())

  events   Event[]
  licenses License[]
  users    User[]
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String?
  password              String?
  phone                 String?
  plan                  String    @default("free") // free | pro | lifetime
  planStatus            String? // active | canceled | past_due | trialing
  planExpiresAt         DateTime?
  stripeCustomerId      String?   @unique
  stripeSubscriptionId  String?   @unique
  organizationId        String?
  createdAt             DateTime  @default(now())

  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  verificationCodes VerificationCode[]
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  userId    String?
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, code])
  @@index([userId])
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  themeConfig    Json         @default("{}")
  startDate      DateTime
  endDate        DateTime?
  isOffline      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booths       Booth[]
  photos       Photo[]
  templates    Template[]

  @@index([organizationId])
}

model Booth {
  id          String    @id @default(cuid())
  eventId     String
  deviceToken String    @unique
  name        String
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos Photo[]

  @@index([eventId])
}

model Photo {
  id           String    @id @default(cuid())
  eventId      String
  boothId      String
  type         String    @default("single")
  originalUrl  String
  processedUrl String?
  aiStyle      String?
  status       String    @default("pending")
  deliveredVia String[]  @default([])
  createdAt    DateTime  @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  booth Booth @relation(fields: [boothId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([boothId])
  @@index([status])
}

model Template {
  id         String @id @default(cuid())
  eventId    String
  layoutJson Json   @default("{}")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model License {
  id              String    @id @default(cuid())
  licenseKey      String    @unique
  plan            String    @default("free") // free | pro | lifetime
  status          String    @default("active") // active | revoked
  maxBooths       Int       @default(1)
  deviceToken     String?   @unique
  organizationId  String?
  activatedAt     DateTime?
  lastValidatedAt DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}
