# --- Infra local (docker-compose) ---
DATABASE_URL=postgresql://photobooth:photobooth@localhost:55432/photobooth?schema=public
REDIS_URL=redis://localhost:6379

# --- S3 / R2 compatible (MinIO en dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photobooth
S3_ACCESS_KEY_ID=boothapp
S3_SECRET_ACCESS_KEY=boothapp-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/photobooth

# --- API (services/api) ---
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002
JWT_SECRET=change-me-in-prod
