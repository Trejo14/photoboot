# --- Infra local (docker-compose) ---
DATABASE_URL=postgresql://photobooth:photobooth@localhost:55432/photobooth?schema=public
REDIS_URL=redis://localhost:6379

# --- S3 / R2 compatible (MinIO en dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photobooth
S3_ACCESS_KEY_ID=boothapp
S3_SECRET_ACCESS_KEY=boothapp-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/photobooth

# --- API (services/api) ---
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,tauri://localhost
JWT_SECRET=cambiar-en-produccion
ADMIN_KEY=cambiar-en-produccion
# Clave (objeto S3/R2) donde se aloja el instalador de la app para descarga
DOWNLOAD_INSTALLER_KEY=installers/birdcam-setup.exe

# --- Landing (apps/landing) ---
# URL a la que apunta el botón "Descargar" (debe resolver el instalador)
NEXT_PUBLIC_DOWNLOAD_URL=http://localhost:4000/download
# URL del panel de administración
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@birdcam.app

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...
STRIPE_SUCCESS_URL=http://localhost:3003/success
STRIPE_CANCEL_URL=http://localhost:3003/cancel

# --- Cabina (apps/booth) ---
VITE_API_URL=http://localhost:4000
VITE_GALLERY_URL=http://localhost:3002
VITE_BIRDCAM_ENV=development

# --- Admin (apps/admin) ---
ADMIN_PASSWORD=cambiar-en-produccion
AUTH_SECRET=cambiar-en-produccion
