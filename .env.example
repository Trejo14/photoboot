# --- Infra local (docker-compose) ---
DATABASE_URL=postgresql://photobooth:photobooth@localhost:55432/photobooth?schema=public
REDIS_URL=redis://localhost:6379

# --- S3 / R2 compatible (MinIO en dev) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=photobooth
S3_ACCESS_KEY_ID=boothapp
S3_SECRET_ACCESS_KEY=boothapp-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/photobooth

# --- API (services/api) ---
PORT=4000
CORS_ORIGIN=http://localhost:3003,http://localhost:5173,tauri://localhost
JWT_SECRET=cambiar-en-produccion
ADMIN_KEY=cambiar-en-produccion
# Clave (objeto S3/R2) donde se aloja el instalador de la app para descarga
DOWNLOAD_INSTALLER_KEY=installers/birdcam-setup.exe
# Horas que se conservan las fotos antes de borrarse automáticamente (S3 + BD)
PHOTO_RETENTION_HOURS=32

# --- Landing (apps/landing) — incluye el sitio público, el panel de admin
# (oculto en /admin) y la galería pública de fotos (/p/[id]) ---
# URL a la que apunta el botón "Descargar" (debe resolver el instalador)
NEXT_PUBLIC_DOWNLOAD_URL=http://localhost:4000/download
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL pública del propio sitio (para robots.txt, sitemap.xml y metadatos Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Contraseña del panel /admin (solo para ti)
ADMIN_PASSWORD=cambiar-en-produccion
# Llave secreta de NextAuth para firmar la sesión del panel /admin
AUTH_SECRET=cambiar-en-produccion

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=noreply@birdcam.app

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...
STRIPE_SUCCESS_URL=http://localhost:3003/success
STRIPE_CANCEL_URL=http://localhost:3003/cancel

# --- Pago manual por SPEI (mientras se activa Stripe) ---
# Datos de tu cuenta bancaria que se muestran al cliente para la transferencia
SPEI_CLABE=000000000000000000
SPEI_BANK_NAME=Nombre de tu banco
SPEI_BENEFICIARY=Nombre del beneficiario

# --- Pago manual por PayPal (mientras se activa Stripe) ---
PAYPAL_ME_LINK=https://paypal.me/tu-usuario
PAYPAL_EMAIL=tu-correo@ejemplo.com

# --- Cabina (apps/booth) ---
VITE_API_URL=http://localhost:4000
# La galería pública ahora vive dentro de landing (/p/[id])
VITE_GALLERY_URL=http://localhost:3003
VITE_BIRDCAM_ENV=development
